# ============================================================================
# SOAR-Lite runtime configuration
# Copy to .env and adjust. Never commit real .env values.
# ============================================================================

# --- General ---------------------------------------------------------------
APP_NAME=SOAR-Lite
APP_ENV=production                 # development | production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS_USING_openssl_rand_hex_32

# --- Database ---------------------------------------------------------------
# Production: postgresql://soarlite:password@postgres:5432/soarlite
# Development (no external service): sqlite:///./data/soarlite.db
DATABASE_URL=sqlite:///./data/soarlite.db

# --- Web ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
# Cookie security
COOKIE_SECURE=false                # set true when served over HTTPS
# HSTS: send Strict-Transport-Security header (true > 0; value in seconds)
HSTS_SECONDS=0

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=480
JWT_ALGORITHM=HS256
# Default admin seeded on first boot
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@soarlite.local
ADMIN_PASSWORD=ChangeMe!NoW1
ADMIN_MUST_CHANGE_PASSWORD=true

# --- Ingest --------------------------------------------------------------------
# Optional. If set, all /api/v1/ingest calls MUST send
#   X-Signature: sha256=<hex> over the raw request body.
INGEST_HMAC_KEY=

# --- Vault / encryption ---------------------------------------------------------
# AES-256-GCM master key. If blank, auto-generated at data/secrets.key (dev only).
SECRETS_MASTER_KEY=

# --- Engine ---------------------------------------------------------------------
ENGINE_POLL_INTERVAL_SECONDS=1.0
ENABLE_EMBEDDED_WORKER=true       # start worker loop inside API process (dev)
MAX_ACTIVE_RUNS=50
DEFAULT_RETRIES=2
DEFAULT_RETRY_BACKOFF_SECONDS=2

# --- Integrations ----------------------------------------------------------------
# Outbound egress allowlist for generic HTTP connectors (comma separated).
# Supports CIDR notation. Internal/metadata ranges are always blocked.
CONNECTOR_EGRESS_ALLOWLIST=0.0.0.0/0

# --- Compliance -------------------------------------------------------------------
# Alert/case retention in days before purging (0 = disabled). Run `python -m app.retention`
AUDIT_RETENTION_DAYS=0
ALERT_RETENTION_DAYS=0
CASE_RETENTION_DAYS=0

# PII redaction: comma separated keys whose values are redacted in stored alerts
REDACTION_KEYS=email,email_address,sender_email,recipient_emails,phone,ssn,password,token,id_token