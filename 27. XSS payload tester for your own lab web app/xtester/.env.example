# xtester - environment configuration (COPY to .env - DO NOT COMMIT .env)
# ---------------------------------------------------------------------------
# Secret material is injected at runtime. Never store real secrets in git.

# Application
APP_ENV=development                  # development | test | production
APP_NAME=xtester
LOG_LEVEL=INFO
# Public base URL used to build the beacon/collector URL injected into payloads
PUBLIC_BASE_URL=http://localhost:8000

# Auth
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# First-run bootstrap admin (created if no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# Database (defaults to file-based sqlite for dev; use postgres in production)
DATABASE_URL=sqlite:///./data/xtester.db
# DATABASE_URL=postgresql+psycopg://xtester:<pw>@db:5432/xtester

# Job queue / worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to 1 when running without redis so scans execute inline (dev / tests)
CELERY_TASK_ALWAYS_EAGER=0

# Scanner behavior
SCAN_DEFAULT_WAIT_MS=800            # settle time (ms) after page load per payload
SCAN_MAX_PAYLOADS=400               # cap on generated candidates per scan
SCAN_CONCURRENCY=2                  # parallel browser contexts
SCAN_HTTP_TIMEOUT=15000             # per-request timeout
SCAN_ALLOW_REDIRECTS=true
# Payloads of these severities get the full browser run, others are triaged quickly
DETECTOR_MIN_CONFIDENCE=0.6

# Security controls
RATE_LIMIT_PER_MINUTE=60            # API rate limit per identity
RATE_LIMIT_SCANS_PER_DAY=50         # daily scan quota per user
AUDIT_LOG_DIR=./data/audit
AUDIT_ENABLE_TAMPER_EVIDENCE=true
# Only these host patterns are scannable. Scans targeting anything else are refused.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,*.lab.local,172.16.*
ALLOW_TOR=false
REQUIRE_HTTPS_FOR_NON_LOCAL=true

# Docker image build args / secrets (see Dockerfile)
VAULT_NAMESPACE=