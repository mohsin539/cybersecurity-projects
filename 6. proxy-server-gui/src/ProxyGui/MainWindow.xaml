<Window x:Class="ProxyGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Suite — Local Proxy Agent" Height="640" Width="980"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Background="#1E293B">
      <TextBlock Text="PROXY SUITE" Foreground="White" FontSize="16" FontWeight="Bold"
                 Margin="16,20,0,4"/>
      <TextBlock x:Name="ServiceStateText" Text="state: unknown" Foreground="#94A3B8" Margin="16,0,0,16"/>
      <Button x:Name="NavDashboard" Content="Dashboard" Click="Nav_Click" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavConnections" Content="Connections" Click="Nav_Click" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavRules" Content="Rules" Click="Nav_Click" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavLogs" Content="Logs" Click="Nav_Click" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavUpstreams" Content="Upstreams" Click="Nav_Click" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavDiagnostics" Content="Diagnostics" Click="Nav_Click" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavSettings" Content="Settings" Click="Nav_Click" HorizontalContentAlignment="Left"/>
    </StackPanel>

    <Grid Grid.Column="1" Margin="16">
      <Grid x:Name="PanelDashboard">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel>
          <Border Background="#0EA5E9" CornerRadius="8" Padding="20" Margin="6" MinWidth="150">
            <StackPanel>
              <TextBlock Text="ACTIVE" Foreground="#E0F2FE" FontSize="11"/>
              <TextBlock x:Name="StatActive" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border Background="#10B981" CornerRadius="8" Padding="20" Margin="6" MinWidth="150">
            <StackPanel>
              <TextBlock Text="SESSIONS" Foreground="#D1FAE5" FontSize="11"/>
              <TextBlock x:Name="StatTotal" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border Background="#EF4444" CornerRadius="8" Padding="20" Margin="6" MinWidth="150">
            <StackPanel>
              <TextBlock Text="BLOCKED" Foreground="#FEE2E2" FontSize="11"/>
              <TextBlock x:Name="StatBlocked" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border Background="#8B5CF6" CornerRadius="8" Padding="20" Margin="6" MinWidth="150">
            <StackPanel>
              <TextBlock Text="ERRORS" Foreground="#EDE9FE" FontSize="11"/>
              <TextBlock x:Name="StatErrors" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
            </StackPanel>
          </Border>
        </WrapPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Uptime: " FontWeight="SemiBold"/>
          <TextBlock x:Name="UptimeText" Text="—"/>
          <TextBlock Text="    Throughput ↑ " FontWeight="SemiBold" Margin="20,0,0,0"/>
          <TextBlock x:Name="BytesUpText" Text="0 B"/>
          <TextBlock Text="  ↓ " FontWeight="SemiBold"/>
          <TextBlock x:Name="BytesDownText" Text="0 B"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Live metrics refresh every 2 s while the service runs."
                   VerticalAlignment="Bottom" Foreground="#64748B"/>
      </Grid>

      <Grid x:Name="PanelConnections" Visibility="Collapsed">
        <DataGrid x:Name="ConnectionsGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Proto" Binding="{Binding Proto}" Width="70"/>
            <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="120"/>
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
            <DataGridTextColumn Header="↑ Bytes" Binding="{Binding BytesUp}" Width="90"/>
            <DataGridTextColumn Header="↓ Bytes" Binding="{Binding BytesDown}" Width="90"/>
            <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="60"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Grid x:Name="PanelRules" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Ordered rules — first match wins. Changes take effect immediately (hot reload)."
                   Foreground="#64748B"/>
        <DataGrid x:Name="RulesGrid" Grid.Row="1" Margin="0,8" IsReadOnly="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90"/>
            <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="110"/>
            <DataGridTextColumn Header="Host" Binding="{Binding Match.Host}" Width="*"/>
            <DataGridTextColumn Header="Port" Binding="{Binding Match.Port}" Width="60"/>
            <DataGridTextColumn Header="Proto" Binding="{Binding Match.Protocol}" Width="70"/>
            <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="Save rules" Click="SaveRules_Click"/>
          <Button Content="Reload" Click="LoadRules_Click"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="PanelLogs" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Content="Refresh" Click="LoadLogs_Click"/>
          <TextBlock Text="Hash-chained audit trail (tamper-evident). Latest events shown."
                     VerticalAlignment="Center" Margin="10,0" Foreground="#64748B"/>
        </StackPanel>
        <ListBox x:Name="LogsList" Grid.Row="1" Margin="0,8" FontFamily="Consolas" FontSize="12"/>
      </Grid>

      <Grid x:Name="PanelUpstreams" Visibility="Collapsed">
        <DataGrid x:Name="UpstreamsGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
            <DataGridTextColumn Header="Healthy" Binding="{Binding Healthy}" Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <Grid x:Name="PanelDiagnostics" Visibility="Collapsed">
        <StackPanel>
          <Button Content="Run self-test" Click="RunDiag_Click" HorizontalAlignment="Left" Width="140"/>
          <TextBlock x:Name="DiagResults" Margin="0,12" TextWrapping="Wrap" FontFamily="Consolas"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="PanelSettings" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Bind addresses &amp; ports (from config.json)" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="SettingsInfo" TextWrapping="Wrap" FontFamily="Consolas"/>
          <TextBlock Text="Admin actions require elevation; the service validates every admin call independently of the GUI."
                     Margin="0,16,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
