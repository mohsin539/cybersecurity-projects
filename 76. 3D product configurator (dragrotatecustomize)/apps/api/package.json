{
  "name": "@prismforge/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PrismForge API - hardened Express service with tamper-evident audit trail and compliance reporting.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "audit:verify": "tsx src/db/cli.ts verify",
    "audit:report": "tsx src/db/cli.ts report",
    "keygen": "tsx src/db/cli.ts keygen"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pdfkit": "^0.15.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "comment": "Persistence uses the Node.js built-in `node:sqlite` driver and password hashing uses `node:crypto` scrypt (NIST SP 800-132) so the platform has ZERO native addons - no supply-chain compiled code paths (OWASP A06:2021) and no node-gyp toolchain requirement in hardened build environments (ISO/IEC 27001 A.8.19)."
}
