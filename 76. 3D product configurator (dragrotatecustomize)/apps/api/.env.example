# ==========================================================================
#  PrismForge API - environment template   (NEVER commit the real .env)
#  Copy to `.env` and fill in real values.  `npm run keygen` generates
#  cryptographically strong secrets for you.
# ==========================================================================

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Milliseconds before the process self-terminates on graceful-shutdown timeout
SHUTDOWN_TIMEOUT_MS=10000
# Trust X-Forwarded-* only when running behind a reverse proxy you control.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Emit stack traces in 500 responses. MUST be false in production (info leak).
EXPOSE_STACK_TRACES=false

# ---- Cryptographic material (min 32 chars each) -------------------------
# Application master key for AES-256-GCM encryption of configuration payloads
# at rest (ISO/IEC 27001 A.8.24 - cryptography).
CONFIG_ENCRYPTION_KEY=
# Key used to HMAC the audit hash chain. Rotating this invalidates chain
# verification, so rotate deliberately and record it in the change log.
AUDIT_HMAC_KEY=
# Signing key for the RS256 access/refresh JWTs.
JWT_SIGNING_KEY=

# ---- Token policy (NIST SP 800-63B: short-lived access, rotated refresh) --
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
# Absolute session cap regardless of activity.
REFRESH_ABSOLUTE_TTL_SECONDS=604800
# Set false in any non-HTTPS environment (also enforced at boot).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---- CORS allow-list (OWASP A05:2021 - no wildcard in production) --------
# Comma-separated exact origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_MAX=20

# ---- Account lockout (ISO/IEC 27001 A.5.17 - authentication information) --
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Storage -------------------------------------------------------------
DATABASE_PATH=./data/prismforge.db
EXPORT_DIR=./data/exports
# Number of days an export may be retained before the janitor removes it.
EXPORT_RETENTION_DAYS=30

# ---- Logging -------------------------------------------------------------
# Log the audit trail to stdout as well as the database. Keep true so the
# SIEM/WORM log collector receives a tamper-evident copy (ISO A.8.15).
AUDIT_LOG_TO_STDOUT=true
